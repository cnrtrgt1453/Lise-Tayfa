rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. SORULAR VE TAKTİKLER (questions)
    match /questions/{questionId} {
      // Giriş yapmış tüm kullanıcılar soruları/taktikleri okuyabilir
      allow read: if request.auth != null;

      // Kullanıcılar sadece kendi adlarına soru oluşturabilir
      allow create: if request.auth != null 
                    && request.resource.data.authorId == request.auth.uid;

      // Sadece sorunun sahibi soruyu silebilir (veya admin)
      allow delete: if request.auth != null 
                    && resource.data.authorId == request.auth.uid;

      // Güncelleme:
      // - Sorunun sahibi tüm alanları güncelleyebilir (çözüldü işaretleme, düzenleme vb.)
      // - DİĞER KULLANICILAR: Beğeni (likeCount, likedBy) ve Yorum Sayısı (commentCount) alanlarını güncelleyebilir!
      allow update: if request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'commentCount'])
      );

      // Çözümler / Yorumlar alt koleksiyonu
      match /solutions/{solutionId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null 
                      && request.resource.data.authorId == request.auth.uid;
        allow delete: if request.auth != null 
                      && resource.data.authorId == request.auth.uid;
        // Yorum sahibi güncelleyebilir VEYA diğer öğrenciler yorumu beğenebilir (likeCount, likedBy)
        allow update: if request.auth != null && (
          resource.data.authorId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy'])
        );
      }
    }

    // 2. KULLANICI PROFİLLERİ (users)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      
      // Kendi profilini düzenleyebilir VEYA başka bir kullanıcı takip edip çıkartabilir (followers)
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers'])
      );

      // Kullanıcının sohbet kutusu (conversations)
      match /conversations/{roomId} {
        allow read, write: if request.auth != null;
      }
    }

    // 3. BİLDİRİMLER (notifications)
    match /notifications/{notificationId} {
      // Herhangi bir kullanıcı beğeni/yorum yapınca bildirim oluşturabilir
      allow create: if request.auth != null;
      // Sadece bildirimin sahibi okuyabilir, okundu olarak güncelleyebilir veya silebilir
      allow read, update, delete: if request.auth != null 
                                  && resource.data.userId == request.auth.uid;
    }

    // 4. GENEL SOHBET (global_chat)
    match /global_chat/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
                    && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }

    // 5. ÖZEL MESAJLAŞMA ODALARI (chat_rooms)
    match /chat_rooms/{roomId}/messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // 6. ŞİKAYET VE BİLDİRİMLER (reports)
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false; // Sadece Firebase Console'dan yönetici görür
    }
  }
}
